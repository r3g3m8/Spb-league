+                type="email"
+                onChange={handle_change}
+                value={form_data.login}
+            />
+            <Input
+                label="Пароль"
+                name="password"
+                type="password"
+                onChange={handle_change}
+                value={form_data.password}
+            />
+            <div className={styles.pass}>Забыли пароль?</div>
